# Required. Comma-separate independent HTTPS endpoints for failover.
INTEGRATION_ID=torch-robinhood
CHAIN_ID=4663
HTTP_RPC_URLS=https://rpc.mainnet.chain.robinhood.com
# Optional but strongly recommended for lower latency. Must be wss://.
WS_RPC_URL=

# Database and scanning. Use a fresh Torchpad database only.
DB_PATH=./data/torchpad-robinhood.sqlite
POLL_INTERVAL_MS=4000
REORG_WINDOW=24
INITIAL_CHUNK_SIZE=100
MIN_CHUNK_SIZE=10
# Optional controlled historical backfill. With no cursor and no value, the
# watcher starts at current reorg window; it does not spam old launches.
# BOOTSTRAP_BLOCK=85204474
FINALITY_CONFIRMATIONS=15

# Set true for required observation period: no Telegram message is sent.
DRY_RUN=true

# Required only when DRY_RUN=false.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Comma-separated numeric Telegram user IDs authorized for /status, /pause, /resume, /last.
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_MIN_INTERVAL_MS=1000
